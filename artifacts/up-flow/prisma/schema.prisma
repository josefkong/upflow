model AutomationRun {
  id            String          @id @default(uuid())
  workspace_id  String
  rule_id       String?
  status        String          @default("success")
  trigger       String
  action_type   String
  dry_run       Boolean         @default(false)
  matched       Int             @default(0)
  executed      Int             @default(0)
  skipped       Int             @default(0)
  failure_count Int             @default(0)
  dedupe_key    String?
  error         String?
  result        Json?
  started_at    DateTime        @default(now())
  finished_at   DateTime?
  created_by    String?
  workspace     Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  rule          AutomationRule? @relation(fields: [rule_id], references: [id], onDelete: SetNull)
  starter       User?           @relation("AutomationRunStarter", fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([workspace_id, dedupe_key])
  @@index([workspace_id, started_at])
  @@index([rule_id])
  @@index([status])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  member
}

enum WorkspaceRole {
  owner
  admin
  member
  guest
}

enum WorkspaceMemberStatus {
  active
  inactive
}

enum InviteSendStatus {
  pending
  sent
  failed
}

enum ProjectStatus {
  active
  archived
}

enum ProjectKind {
  client
  internal
  operational_queue
  onboarding
}

enum ClientSalesChannel {
  WHOLESALE
  RETAIL
  BOTH
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum NotificationType {
  assigned
  commented
  due_soon
  member_joined
  status_changed
  mentioned
}

enum CustomFieldType {
  text
  number
  dropdown
  date
  checkbox
  people
}

enum CalendarEventType {
  meeting
  client_call
  internal_meeting
  task
  reminder
  deadline
}

enum CalendarEventStatus {
  scheduled
  cancelled
}

enum GoogleCalendarSyncStatus {
  pending
  synced
  failed
}

enum GoogleCalendarSyncOperation {
  upsert
  delete
}

enum GoogleCalendarSyncJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

enum CalendarEventAttachmentKind {
  file
  link
  document
}

enum TimeEntryStatus {
  running
  paused
  stopped
}

model User {
  id                                       String                            @id @default(uuid())
  email                                    String                            @unique
  name                                     String
  phone                                    String?
  avatar_url                               String?
  role                                     Role                              @default(member)
  password_hash                            String?
  created_at                               DateTime                          @default(now())
  projects                                 Project[]
  tasks                                    Task[]                            @relation("AssignedTasks")
  task_following                           TaskFollower[]
  comments                                 Comment[]
  docs                                     Doc[]
  notifications                            Notification[]
  spaces                                   Space[]
  folders                                  Folder[]
  memberships                              WorkspaceMember[]
  invites_sent                             WorkspaceInvite[]                 @relation("Inviter")
  calendar_events_created                  CalendarEvent[]                   @relation("CalendarEventsCreated")
  calendar_events_responsible              CalendarEvent[]                   @relation("CalendarEventsResponsible")
  calendar_events_cancelled                CalendarEvent[]                   @relation("CalendarEventsCancelled")
  calendar_event_attendees                 CalendarEventAttendee[]           @relation("CalendarEventAttendees")
  calendar_event_attachments_created       CalendarEventAttachment[]         @relation("CalendarEventAttachmentCreator")
  google_calendar_connections              GoogleCalendarConnection[]
  google_calendar_oauth_states             GoogleCalendarOAuthState[]
  google_calendar_sync_jobs                GoogleCalendarSyncJob[]
  google_calendar_agenda_entries           GoogleCalendarAgendaEntry[]
  time_entries                             TimeEntry[]
  activity_events                          ActivityEvent[]                   @relation("ActivityActor")
  companies_owned                          Company[]                         @relation("CompanyOwner")
  project_memberships                      ProjectMember[]
  recurring_task_rules                     RecurringTaskRule[]               @relation("RecurringTaskRuleCreator")
  saved_views                              SavedView[]
  automation_rules                         AutomationRule[]                  @relation("AutomationRuleCreator")
  automation_runs_started                  AutomationRun[]                   @relation("AutomationRunStarter")
  goals_owned                              Goal[]                            @relation("GoalOwner")
  company_notes                            CompanyNote[]                     @relation("CompanyNoteAuthor")
  templates_created                        Template[]                        @relation("TemplateCreator")
  approval_requests_made                   ApprovalRequest[]                 @relation("ApprovalRequester")
  approval_requests_owned                  ApprovalRequest[]                 @relation("ApprovalApprover")
  approval_events                          ApprovalEvent[]                   @relation("ApprovalEventActor")
  client_reports_authored                  ClientReport[]                    @relation("ClientReportAuthor")
  client_reports_approved                  ClientReport[]                    @relation("ClientReportApprover")
  client_reports_sent                      ClientReport[]                    @relation("ClientReportSender")
  projects_sold                            Project[]                         @relation("ProjectResponsibleSalesperson")
  onboarding_created                       ClientOnboarding[]                @relation("ClientOnboardingCreator")
  onboarding_sales                         ClientOnboarding[]                @relation("ClientOnboardingSalesperson")
  onboarding_items_owned                   OnboardingChecklistItem[]         @relation("OnboardingChecklistOwner")
  onboarding_items_done                    OnboardingChecklistItem[]         @relation("OnboardingChecklistCompleter")
  onboarding_assignments                   OnboardingServiceAssignment[]     @relation("OnboardingServiceLeader")
  onboarding_meetings                      OnboardingMeeting[]               @relation("OnboardingMeetingLeader")
  onboarding_contracts                     ClientContract[]                  @relation("ClientContractUploader")
  support_groups_created                   SupportGroup[]                    @relation("SupportGroupCreator")
  service_leader_mappings                  ServiceLeaderMapping[]            @relation("ServiceLeaderMappingLeader")
  service_backup_mappings                  ServiceLeaderMapping[]            @relation("ServiceLeaderMappingBackupLeader")
  service_leader_mapping_backup_owners     ServiceLeaderMappingBackupOwner[]
  led_departments                          Department[]                      @relation("DepartmentLeader")
  marketing_b2b_onboarding_forms_completed MarketingB2BOnboardingForm[]      @relation("MarketingB2BOnboardingFormCompleter")
  marketing_b2c_onboarding_forms_completed MarketingB2COnboardingForm[]      @relation("MarketingB2COnboardingFormCompleter")
  sidebar_client_pins                      SidebarClientPin[]
  sidebar_space_hides                      SidebarSpaceHide[]
  social_media_plans_managed               SocialMediaContentPlan[]          @relation("SocialMediaPlanManager")
  social_media_plans_designed              SocialMediaContentPlan[]          @relation("SocialMediaPlanDesigner")
  commercial_leads_assigned                CommercialLead[]                  @relation("CommercialLeadAssignee")
  commercial_leads_created                 CommercialLead[]                  @relation("CommercialLeadCreator")
  commercial_proposals_uploaded            CommercialLead[]                  @relation("CommercialLeadProposalUploader")
  commercial_proposal_archive_uploads      CommercialProposalDocument[]      @relation("CommercialProposalDocumentUploader")
  equipment_items_created                  EquipmentItem[]                   @relation("EquipmentItemCreator")
  equipment_items_held                     EquipmentItem[]                   @relation("EquipmentCurrentHolder")
  equipment_items_last_held                EquipmentItem[]                   @relation("EquipmentLastHolder")
  equipment_checkouts_requested            EquipmentCheckout[]               @relation("EquipmentCheckoutRequester")
  equipment_checkouts_administered         EquipmentCheckout[]               @relation("EquipmentCheckoutAdministrator")
  equipment_custody_events_acted           EquipmentCustodyEvent[]           @relation("EquipmentCustodyEventActor")
  equipment_custody_events_held            EquipmentCustodyEvent[]           @relation("EquipmentCustodyEventHolder")
}

model Workspace {
  id                             String                        @id @default(uuid())
  name                           String
  slug                           String                        @unique
  created_at                     DateTime                      @default(now())
  members                        WorkspaceMember[]
  invites                        WorkspaceInvite[]
  spaces                         Space[]
  folders                        Folder[]
  projects                       Project[]
  docs                           Doc[]
  notifications                  Notification[]
  departments                    Department[]
  calendar_events                CalendarEvent[]
  google_calendar_connections    GoogleCalendarConnection[]
  google_calendar_oauth_states   GoogleCalendarOAuthState[]
  google_calendar_sync_jobs      GoogleCalendarSyncJob[]
  google_calendar_agenda_entries GoogleCalendarAgendaEntry[]
  time_entries                   TimeEntry[]
  activity_events                ActivityEvent[]
  companies                      Company[]
  company_contacts               CompanyContact[]
  company_notes                  CompanyNote[]
  templates                      Template[]
  recurring_task_rules           RecurringTaskRule[]
  saved_views                    SavedView[]
  automation_rules               AutomationRule[]
  automation_runs                AutomationRun[]
  goals                          Goal[]
  workflow_statuses              WorkflowStatus[]
  approval_requests              ApprovalRequest[]
  approval_events                ApprovalEvent[]
  client_reports                 ClientReport[]
  client_onboardings             ClientOnboarding[]
  onboarding_items               OnboardingChecklistItem[]
  onboarding_assignments         OnboardingServiceAssignment[]
  onboarding_meetings            OnboardingMeeting[]
  client_contracts               ClientContract[]
  client_addresses               ClientAddress[]
  support_groups                 SupportGroup[]
  service_leader_mappings        ServiceLeaderMapping[]
  marketing_b2b_onboarding_forms MarketingB2BOnboardingForm[]
  marketing_b2c_onboarding_forms MarketingB2COnboardingForm[]
  sidebar_client_pins            SidebarClientPin[]
  sidebar_space_hides            SidebarSpaceHide[]
  import_jobs                    ImportJob[]
  commercial_leads               CommercialLead[]
  commercial_proposal_documents  CommercialProposalDocument[]
  equipment_items                EquipmentItem[]
  equipment_checkouts            EquipmentCheckout[]
  equipment_custody_events       EquipmentCustodyEvent[]
}

enum ImportJobStatus {
  previewed
  queued
  running
  paused
  completed
  cancelled
  failed
}

model ImportJob {
  id                  String          @id @default(uuid())
  workspace_id        String
  source_workspace_id String
  selected_source_ids Json
  status              ImportJobStatus @default(previewed)
  cursor              Int             @default(0)
  total               Int             @default(0)
  imported            Int             @default(0)
  skipped             Int             @default(0)
  failed              Int             @default(0)
  report              Json?
  created_by          String
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  started_at          DateTime?
  completed_at        DateTime?
  workspace           Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  mappings            ImportMapping[]

  @@index([workspace_id, status])
  @@index([created_by])
}

model ImportMapping {
  id                  String    @id @default(uuid())
  job_id              String
  workspace_id        String
  source_workspace_id String
  entity_type         String
  source_id           String
  target_id           String?
  status              String    @default("imported")
  error               String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  job                 ImportJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([source_workspace_id, entity_type, source_id])
  @@index([job_id, status])
  @@index([workspace_id, entity_type])
}

model WorkspaceMember {
  id            String                @id @default(uuid())
  workspace_id  String
  user_id       String
  role          WorkspaceRole         @default(member)
  status        WorkspaceMemberStatus @default(active)
  department_id String?
  created_at    DateTime              @default(now())
  workspace     Workspace             @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department    Department?           @relation(fields: [department_id], references: [id], onDelete: SetNull)

  @@unique([workspace_id, user_id])
  @@index([user_id])
  @@index([department_id])
  @@index([status])
  @@index([workspace_id, status])
  @@index([workspace_id, status, department_id])
}

model Department {
  id                      String                        @id @default(uuid())
  workspace_id            String
  name                    String
  color                   String                        @default("slate")
  sort_order              Int                           @default(0)
  leader_id               String?
  created_at              DateTime                      @default(now())
  workspace               Workspace                     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  leader                  User?                         @relation("DepartmentLeader", fields: [leader_id], references: [id], onDelete: SetNull)
  members                 WorkspaceMember[]
  onboarding_assignments  OnboardingServiceAssignment[]
  service_leader_mappings ServiceLeaderMapping[]

  @@unique([workspace_id, name])
  @@index([workspace_id])
  @@index([leader_id])
}

model WorkspaceInvite {
  id            String           @id @default(uuid())
  workspace_id  String
  email         String
  role          WorkspaceRole    @default(member)
  token_hash    String           @unique
  expires_at    DateTime
  invited_by    String
  tester_invite Boolean          @default(false)
  invite_mode   String           @default("personal_workspace")
  send_status   InviteSendStatus @default(pending)
  send_error    String?
  last_sent_at  DateTime?
  accepted_by   String?
  accepted_at   DateTime?
  created_at    DateTime         @default(now())
  workspace     Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  inviter       User             @relation("Inviter", fields: [invited_by], references: [id])

  @@index([workspace_id])
  @@index([email])
  @@index([tester_invite])
  @@index([invite_mode])
  @@index([send_status])
  @@index([workspace_id, accepted_at, expires_at])
}

model Space {
  id                  String             @id @default(uuid())
  name                String
  icon                String?
  workspace_id        String
  owner_id            String
  position            Int                @default(0)
  sidebar_hidden      Boolean            @default(false)
  created_at          DateTime           @default(now())
  workspace           Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  owner               User               @relation(fields: [owner_id], references: [id])
  projects            Project[]
  folders             Folder[]
  workflow_statuses   WorkflowStatus[]
  calendar_events     CalendarEvent[]
  sidebar_space_hides SidebarSpaceHide[]

  @@index([workspace_id])
  @@index([workspace_id, position, created_at])
  @@index([workspace_id, sidebar_hidden])
}

model Folder {
  id             String    @id @default(uuid())
  name           String
  icon           String?
  space_id       String
  workspace_id   String
  owner_id       String
  parent_id      String?
  position       Int       @default(0)
  sidebar_hidden Boolean   @default(false)
  created_at     DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  space          Space     @relation(fields: [space_id], references: [id], onDelete: Cascade)
  owner          User      @relation(fields: [owner_id], references: [id])
  parent         Folder?   @relation("FolderChildren", fields: [parent_id], references: [id], onDelete: SetNull)
  children       Folder[]  @relation("FolderChildren")
  projects       Project[]

  @@index([workspace_id])
  @@index([parent_id])
  @@index([space_id, parent_id])
  @@index([workspace_id, position, created_at])
  @@index([workspace_id, sidebar_hidden])
}

model Project {
  id                             String                       @id @default(uuid())
  name                           String
  description                    String?
  status                         ProjectStatus                @default(active)
  kind                           ProjectKind                  @default(internal)
  approval_status                String                       @default("draft")
  approval_stage                 String                       @default("draft")
  approval_requested_at          DateTime?
  approval_approved_at           DateTime?
  workspace_id                   String
  owner_id                       String
  space_id                       String?
  folder_id                      String?
  company_id                     String?
  onboarding_enabled             Boolean                      @default(false)
  sidebar_hidden                 Boolean                      @default(false)
  closing_date                   DateTime?
  onboarding_start_date          DateTime?
  responsible_salesperson_id     String?
  initial_notes                  String?
  due_date                       DateTime?
  position                       Int                          @default(0)
  created_at                     DateTime                     @default(now())
  workspace                      Workspace                    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  owner                          User                         @relation(fields: [owner_id], references: [id])
  space                          Space?                       @relation(fields: [space_id], references: [id], onDelete: SetNull)
  folder                         Folder?                      @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  company                        Company?                     @relation(fields: [company_id], references: [id], onDelete: SetNull)
  tasks                          Task[]
  docs                           Doc[]
  custom_fields                  CustomFieldDefinition[]
  calendar_events                CalendarEvent[]
  time_entries                   TimeEntry[]
  project_members                ProjectMember[]
  recurring_task_rules           RecurringTaskRule[]
  workflow_statuses              WorkflowStatus[]
  client_onboarding              ClientOnboarding?
  onboarding_contracts           ClientContract[]
  marketing_b2b_onboarding_forms MarketingB2BOnboardingForm[]
  marketing_b2c_onboarding_forms MarketingB2COnboardingForm[]
  responsible_salesperson        User?                        @relation("ProjectResponsibleSalesperson", fields: [responsible_salesperson_id], references: [id], onDelete: SetNull)
  social_media_content_plans     SocialMediaContentPlan[]
  equipment_items                EquipmentItem[]
  equipment_checkouts            EquipmentCheckout[]

  @@index([workspace_id])
  @@index([workspace_id, status, due_date])
  @@index([workspace_id, kind, status])
  @@index([workspace_id, company_id, kind])
  @@index([workspace_id, space_id, created_at])
  @@index([workspace_id, folder_id, created_at])
  @@index([workspace_id, space_id, folder_id, position, created_at], map: "Project_sidebar_position_idx")
  @@index([workspace_id, sidebar_hidden, created_at])
  @@index([company_id])
  @@index([responsible_salesperson_id])
}

model Task {
  id                            String                      @id @default(uuid())
  title                         String
  description                   String?
  status                        TaskStatus                  @default(todo)
  approval_status               String                      @default("draft")
  approval_stage                String                      @default("draft")
  approval_requested_at         DateTime?
  approval_approved_at          DateTime?
  priority                      TaskPriority                @default(medium)
  project_id                    String
  assignee_id                   String?
  parent_id                     String?
  company_id                    String?
  cover_image_url               String?
  due_date                      DateTime?
  position                      Int                         @default(0)
  created_at                    DateTime                    @default(now())
  project                       Project                     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee                      User?                       @relation("AssignedTasks", fields: [assignee_id], references: [id])
  parent                        Task?                       @relation("Subtasks", fields: [parent_id], references: [id])
  subtasks                      Task[]                      @relation("Subtasks")
  company                       Company?                    @relation(fields: [company_id], references: [id], onDelete: SetNull)
  comments                      Comment[]
  notifications                 Notification[]
  custom_field_values           CustomFieldValue[]
  calendar_events               CalendarEvent[]
  time_entries                  TimeEntry[]
  dependencies                  TaskDependency[]            @relation("TaskDependencies")
  dependents                    TaskDependency[]            @relation("TaskDependents")
  recurring_rules               RecurringTaskRule[]
  onboarding_items              OnboardingChecklistItem[]
  marketing_b2b_onboarding_form MarketingB2BOnboardingForm?
  marketing_b2c_onboarding_form MarketingB2COnboardingForm?
  social_media_plan_id          String?
  social_media_plan             SocialMediaContentPlan?     @relation("SocialMediaContentPlanTasks", fields: [social_media_plan_id], references: [id], onDelete: SetNull)
  moodboard_for_plan            SocialMediaContentPlan?     @relation("SocialMediaMoodboardTask")
  commercial_lead               CommercialLead?             @relation("CommercialLeadTask")
  commercial_proposal_checklist CommercialLead?             @relation("CommercialLeadProposalChecklist")
  commercial_follow_up          CommercialLead?             @relation("CommercialLeadFollowUpTask")
  commercial_contract_handoff   CommercialLead?             @relation("CommercialLeadContractHandoffTask")
  commercial_finance_contract   CommercialLead?             @relation("CommercialLeadFinanceContractTask")
  followers                     TaskFollower[]
  equipment_checkout            EquipmentCheckout?

  @@index([company_id])
  @@index([project_id, status, position])
  @@index([project_id, parent_id])
  @@index([assignee_id, status, due_date])
  @@index([company_id, status, due_date])
  @@index([parent_id])
  @@index([due_date])
  @@index([social_media_plan_id])
}

model TaskFollower {
  id         String   @id @default(uuid())
  task_id    String
  user_id    String
  created_at DateTime @default(now())
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([user_id])
}

model CustomFieldDefinition {
  id         String             @id @default(uuid())
  project_id String
  name       String
  type       CustomFieldType
  options    Json?
  position   Int                @default(0)
  created_at DateTime           @default(now())
  project    Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  values     CustomFieldValue[]

  @@index([project_id])
}

model CustomFieldValue {
  id            String                @id @default(uuid())
  task_id       String
  definition_id String
  value         Json?
  updated_at    DateTime              @updatedAt
  task          Task                  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  definition    CustomFieldDefinition @relation(fields: [definition_id], references: [id], onDelete: Cascade)

  @@unique([task_id, definition_id])
  @@index([definition_id])
}

model CalendarEvent {
  id                           String                    @id @default(uuid())
  workspace_id                 String
  title                        String
  description                  String?
  type                         CalendarEventType         @default(meeting)
  starts_at                    DateTime
  ends_at                      DateTime?
  timezone                     String?
  created_by                   String
  project_id                   String?
  task_id                      String?
  company_id                   String?
  space_id                     String?
  responsible_user_id          String?
  priority                     TaskPriority              @default(medium)
  status                       CalendarEventStatus       @default(scheduled)
  cancelled_at                 DateTime?
  cancelled_by                 String?
  location                     String?
  meeting_url                  String?
  google_meet_requested        Boolean                   @default(false)
  color                        String?
  created_at                   DateTime                  @default(now())
  updated_at                   DateTime                  @updatedAt
  workspace                    Workspace                 @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator                      User                      @relation("CalendarEventsCreated", fields: [created_by], references: [id], onDelete: Cascade)
  project                      Project?                  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  task                         Task?                     @relation(fields: [task_id], references: [id], onDelete: SetNull)
  company                      Company?                  @relation(fields: [company_id], references: [id], onDelete: SetNull)
  space                        Space?                    @relation(fields: [space_id], references: [id], onDelete: SetNull)
  responsible                  User?                     @relation("CalendarEventsResponsible", fields: [responsible_user_id], references: [id], onDelete: SetNull)
  cancelled_by_user            User?                     @relation("CalendarEventsCancelled", fields: [cancelled_by], references: [id], onDelete: SetNull)
  attendees                    CalendarEventAttendee[]
  reminders                    CalendarEventReminder[]
  attachments                  CalendarEventAttachment[]
  google_calendar_links        GoogleCalendarEventLink[]
  google_calendar_sync_jobs    GoogleCalendarSyncJob[]
  commercial_lead_presentation CommercialLead?           @relation("CommercialLeadPresentationEvent")

  @@index([workspace_id, starts_at])
  @@index([created_by])
  @@index([project_id])
  @@index([task_id])
  @@index([company_id])
  @@index([space_id])
  @@index([responsible_user_id])
  @@index([workspace_id, status, starts_at])
}

model CommercialLead {
  id                                     String                       @id @default(uuid())
  workspace_id                           String
  task_id                                String                       @unique
  presentation_event_id                  String?                      @unique
  proposal_checklist_task_id             String?                      @unique
  follow_up_task_id                      String?                      @unique
  contract_handoff_task_id               String?                      @unique
  finance_contract_task_id               String?                      @unique
  brand_name                             String
  owner_name                             String
  owner_email                            String
  instagram                              String
  monthly_revenue                        Decimal                      @db.Decimal(14, 2)
  whatsapp                               String
  notes                                  String
  presentation_starts_at                 DateTime?
  presentation_ends_at                   DateTime?
  assignee_id                            String
  company_type                           String
  observations                           String?
  stage                                  String                       @default("lead")
  presentation_confirmation_requested_at DateTime?
  presentation_confirmed_at              DateTime?
  qualified_at                           DateTime?
  archived_at                            DateTime?
  archive_reason                         String?
  group_up_plan                          String?
  group_up_monthly_fee                   Decimal?                     @db.Decimal(14, 2)
  up_zero_plan                           String?
  up_zero_monthly_fee                    Decimal?                     @db.Decimal(14, 2)
  up_zero_implementation_fee             Decimal?                     @db.Decimal(14, 2)
  negotiated_scope                       Json?
  negotiation_checklist_completed_at     DateTime?
  proposal_file_name                     String?
  proposal_storage_bucket                String?
  proposal_storage_path                  String?
  proposal_mime_type                     String?
  proposal_size_bytes                    Int?
  proposal_uploaded_by                   String?
  proposal_uploaded_at                   DateTime?
  next_follow_up_at                      DateTime?
  follow_up_count                        Int                          @default(0)
  follow_up_stage                        String?
  follow_up_notification_sent_at         DateTime?
  contract_cnpj                          String?
  contract_legal_name                    String?
  contract_plan                          String?
  contract_services                      Json?
  contract_monthly_fee                   Decimal?                     @db.Decimal(14, 2)
  contract_confirmed_at                  DateTime?
  closed_at                              DateTime?
  created_by                             String
  created_at                             DateTime                     @default(now())
  updated_at                             DateTime                     @updatedAt
  workspace                              Workspace                    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  task                                   Task                         @relation("CommercialLeadTask", fields: [task_id], references: [id], onDelete: Cascade)
  presentation_event                     CalendarEvent?               @relation("CommercialLeadPresentationEvent", fields: [presentation_event_id], references: [id], onDelete: SetNull)
  proposal_checklist_task                Task?                        @relation("CommercialLeadProposalChecklist", fields: [proposal_checklist_task_id], references: [id], onDelete: SetNull)
  follow_up_task                         Task?                        @relation("CommercialLeadFollowUpTask", fields: [follow_up_task_id], references: [id], onDelete: SetNull)
  contract_handoff_task                  Task?                        @relation("CommercialLeadContractHandoffTask", fields: [contract_handoff_task_id], references: [id], onDelete: SetNull)
